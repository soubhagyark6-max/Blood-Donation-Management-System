# Copy this file to ".env" (same folder as pom.xml) and edit the values.
# ".env" is ignored by git - never commit real passwords.

# --- MySQL connection ---
DB_URL=jdbc:mysql://localhost:3306/lifelink?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Kolkata
DB_USERNAME=root
DB_PASSWORD=change_me

# --- Application ---
SERVER_PORT=8080
# update = create/update tables automatically. Use "validate" after running database/schema.sql manually.
DDL_AUTO=update
THYMELEAF_CACHE=false

# --- Demo data (accounts + sample records, labelled DEMO in the UI) ---
DEMO_DATA_ENABLED=true
DEMO_PASSWORD=Demo@12345

# --- Business settings ---
LOW_STOCK_THRESHOLD=5
EXPIRY_ALERT_DAYS=7
DONATION_INTERVAL_DAYS=90
